{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/alang_mcp.py": {
      "maxDuration": 300
    },
    "api/health.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/alang_mcp"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
